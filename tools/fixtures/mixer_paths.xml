<?xml version="1.0" encoding="UTF-8"?>
<!-- Trimmed but structurally faithful mixer_paths_*.xml fragment.
     Includes deliberate edge cases: an implausible stock value, a
     non-numeric value, and a control that must not be touched. -->
<mixer>
    <ctl name="RX0 Digital Volume" value="84" />
    <ctl name="RX1 Digital Volume" value="84" />
    <ctl name="RX2 Digital Volume" value="88" />
    <ctl name="RX_RX0 Digital Volume" value="80" />

    <!-- implausible stock value: codec is not what we assumed, must be skipped -->
    <ctl name="RX3 Digital Volume" value="20" />

    <!-- non-numeric: must be left alone -->
    <ctl name="RX4 Digital Volume" value="Two" />

    <!-- not in the whitelist: must be left alone even though it says Volume -->
    <ctl name="ADC1 Volume" value="84" />
    <ctl name="TX_DEC0 Volume" value="84" />
    <ctl name="IIR1 INP0 Volume" value="84" />

    <path name="deep-buffer-playback">
        <ctl name="RX_RX0 Digital Volume" value="80" />
        <ctl name="SLIM RX0 MUX" value="AIF1_PB" />
    </path>

    <path name="speaker">
        <ctl name="SpkrLeft COMP Switch" value="1" />
        <ctl name="SpkrLeft BOOST Switch" value="1" />
    </path>
</mixer>
