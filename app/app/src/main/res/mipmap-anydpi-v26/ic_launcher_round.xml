<?xml version="1.0" encoding="utf-8"?>
<!-- Same layers as ic_launcher. Kept because some OEM launchers, HyperOS
     among them, still query roundIcon explicitly; adaptive icons are masked by
     the launcher anyway, so this is a compatibility alias, not a variant. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@mipmap/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
  <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>