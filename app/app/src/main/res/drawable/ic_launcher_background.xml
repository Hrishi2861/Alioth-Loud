<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background. A diagonal gradient rather than a flat fill so the
  white cone reads clearly at small sizes against either end of the ramp.

  The full 108x108 is painted because the launcher mask crops the background
  layer, and the adaptive-icon spec also lets it be scaled/parallaxed, so any
  unpainted region would show as a hard edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF2B5D8B" />
                <item android:offset="1.0" android:color="#FF0E1C2B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
