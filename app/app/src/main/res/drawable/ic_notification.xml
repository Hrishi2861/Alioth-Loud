<?xml version="1.0" encoding="utf-8"?>
<!--
  Status bar icon. Android renders notification small icons as an alpha mask:
  every non-transparent pixel becomes the accent colour and the RGB channels are
  thrown away. So this is deliberately a flat white silhouette on transparent,
  with no gradient and no background plate, which would otherwise show up as a
  filled square in the status bar.

  Standard 24x24 icon canvas, artwork inset to leave the ~2dp optical padding
  the system expects.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,10 L7.5,10 L12,5.5 L12,18.5 L7.5,14 L4,14 Z" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M15,9 a4,4 0 0 1 0,6" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M18,6.5 a7.5,7.5 0 0 1 0,11" />
</vector>
