<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: speaker cone with two sound arcs.

  Drawn on the standard 108x108 adaptive-icon canvas. The launcher applies its
  own mask and only the centre 72x72 is guaranteed visible, so all artwork is
  kept inside roughly x/y 26..82 to survive a circular or squircle mask without
  clipping the arcs.

  Vector rather than PNG on purpose: one file instead of five density buckets,
  sharp on any launcher grid size, and about 1 KB instead of ~40 KB.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Cone: back plate on the left, flare opening to the right. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,46 L43,46 L58,31 L58,77 L43,62 L32,62 Z" />

    <!-- Inner arc: the quieter wave. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M66,42 a14,14 0 0 1 0,24" />

    <!-- Outer arc: the louder wave. This is the whole point of the app. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M75,33 a25,25 0 0 1 0,42" />
</vector>
