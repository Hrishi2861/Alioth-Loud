<?xml version="1.0" encoding="utf-8"?>
<!--
  Monochrome layer for Android 13+ themed icons.
  The system ignores these colours entirely and re-tints the shape to match the
  user's wallpaper palette, so this is the silhouette only, with no background.
  It must stay a single flat shape: gradients or multiple colours here come out
  as a solid blob once tinted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,46 L43,46 L58,31 L58,77 L43,62 L32,62 Z" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M66,42 a14,14 0 0 1 0,24" />
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M75,33 a25,25 0 0 1 0,42" />
</vector>
