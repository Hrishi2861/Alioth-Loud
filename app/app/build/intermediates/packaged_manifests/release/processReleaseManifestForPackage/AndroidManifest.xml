<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.f3.aliothloud"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="31"
        android:targetSdkVersion="35" />

    <!--
      MODIFY_DEFAULT_AUDIO_EFFECTS is the one that matters. AudioFlinger's
      createEffect() gates AUDIO_SESSION_OUTPUT_MIX (session 0) behind
      modifyDefaultAudioEffectsAllowed(). It is signature|privileged, so it is
      only granted when the module has installed this APK into
      /system/priv-app AND shipped a privapp-permissions entry naming it.

      Every permission listed here must appear in
      module/payload/permissions/privapp-permissions-aliothloud.xml. Android
      throws in PermissionManagerService for a priv-app requesting a
      signature|privileged permission that is not allowlisted, and on some
      builds that is a boot failure, so the two files must stay in sync.
    -->
    <uses-permission android:name="android.permission.MODIFY_DEFAULT_AUDIO_EFFECTS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS_PRIVILEGED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <permission
        android:name="com.f3.aliothloud.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.f3.aliothloud.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:extractNativeLibs="false"
        android:icon="@android:drawable/ic_lock_silent_mode_off"
        android:label="Alioth Loud"
        android:supportsRtl="true"
        android:theme="@style/Theme.AliothLoud" >
        <activity
            android:name="com.f3.aliothloud.MainActivity"
            android:exported="true"
            android:label="Alioth Loud" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.f3.aliothloud.EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse" >

            <!-- Required from Android 14 when using the specialUse type. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Holds a global AudioEffect handle on session 0. The effect is                     destroyed if its owning process exits, so the process must stay                     resident for system-wide processing to remain active." />
        </service>

        <receiver
            android:name="com.f3.aliothloud.BootReceiver"
            android:directBootAware="false"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.f3.aliothloud.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>